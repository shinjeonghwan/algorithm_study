#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

int N;
vector<int> A(10001, 0);


int main() {
	ios::sync_with_stdio(false);
	cin.tie(0);
	cout.tie(0);

	cin >> N;
	for (int i = 0; i < N; i++) {
		int tmp;
		cin >> tmp;
		A[tmp]++;
	}
	
	for (int i = 1; i < 10001; i++) {
		while (A[i]--) {
			cout << i << '\n';
		}
	}
	return 0;
}
