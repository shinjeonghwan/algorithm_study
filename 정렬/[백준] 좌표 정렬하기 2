#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

struct point {
	int x;
	int y;
	point(int X, int Y) : x(X), y(Y){}
};

int N, M;
vector<point> A;



int main() {
	ios::sync_with_stdio(false);
	cin.tie(0);
	cout.tie(0);

	cin >> N;
	for (int i = 0; i < N; i++) {
		int tmp_x, tmp_y;
		cin >> tmp_x >> tmp_y;
		A.push_back(point(tmp_x, tmp_y));
	}

	sort(A.begin(), A.end(), [](const point& A, const point& B) {
		if (A.y == B.y) {
			return	A.x < B.x;
		}
		else {
			return A.y < B.y;
		}
		});

	for (int i = 0; i < A.size(); i++) {
		cout << A[i].x << ' ' << A[i].y << '\n';
	}

	return 0;
}
