#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

int N, M;
vector<string> A;

int main() {
	ios::sync_with_stdio(false);
	cin.tie(0);
	cout.tie(0);

	cin >> N;
	for (int i = 0; i < N; i++) {
		string tmp;
		cin >> tmp;
		A.push_back(tmp);
	}

	//unique 사용하기 위한 1차 sort
	sort(A.begin(), A.end());
	auto it = std::unique(A.begin(), A.end());
	A.erase(it, A.end());

	sort(A.begin(), A.end(), [](const string& a, const string& b) {
		if (a.length() == b.length()) {
			return a < b;  // 길이가 같으면 사전식 오름차순으로 정렬
		}
		return a.length() < b.length();  // 길이가 짧은 것이 먼저 오도록 정렬
		});

	for (int i = 0; i < A.size(); i++) {
		cout << A[i] << '\n';
	}

	return 0;
}
